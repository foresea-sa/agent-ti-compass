[Unit]
Description=Foresea Starlink Dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=-/etc/starlink-agent/secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=@@INSTALL_DIR@@/.playwright
ExecStartPre=@@INSTALL_DIR@@/bootstrap-dashboard-linux.sh
ExecStart=@@INSTALL_DIR@@/.venv/bin/python @@INSTALL_DIR@@/dashboard.py
Restart=always
RestartSec=5
TimeoutStartSec=6min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
