[Unit]
Description=Foresea Starlink Consumption Agent v0.9.0
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=/etc/starlink-agent/secrets.env
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=@@INSTALL_DIR@@/.playwright
ExecStart=/usr/bin/flock -w 360 @@INSTALL_DIR@@/data/collection.lock @@INSTALL_DIR@@/.venv/bin/python @@INSTALL_DIR@@/agent.py
TimeoutStartSec=8min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
